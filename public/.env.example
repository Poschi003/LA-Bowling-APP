# Local development only. Copy to .env if needed.
WE2_PORT=4185

# Backend sessions. Use a long random value in Vercel.
WE2_SESSION_SECRET=

# Server-side login codes. Set these in Vercel Environment Variables.
WE2_CODE_CHRISTIAN=
WE2_CODE_JENNY=
WE2_CODE_CONTROL=

# Optional persistent Vercel/Upstash KV storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
WE2_STORAGE_KEY=we2:state

# Optional true Web Push.
# Generate a VAPID pair and set both keys in Vercel.
WE2_PUSH_SUBJECT=mailto:hello@we2.local
WE2_PUSH_PUBLIC_KEY=
WE2_PUSH_PRIVATE_KEY=

# Local backend data file. Never commit this file.
WE2_DATA_FILE=private/we2-backend.json

# Future server-only values.
# Never expose secret keys in app.js or index.html.
# OPENAI_API_KEY=
